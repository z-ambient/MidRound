# MidRound configuration — copy to .env (or export in the environment) and
# adjust. Every setting has a sensible local-dev default; nothing here is
# required to run on localhost.

# Port the server listens on.
PORT=4310

# FACEIT Data API base URL. Only change for testing against a mock server.
FACEIT_API_BASE=https://open.faceit.com/data/v4

# How many trusted reverse proxies sit in front of the app (0 = none).
# Rate limiting reads the client IP from the RIGHT end of X-Forwarded-For,
# counting this many hops back, so spoofed client-sent entries are ignored.
# Local dev / direct exposure: 0 (the header is ignored entirely).
# Behind one proxy (nginx, Caddy, Railway, Fly, ...): 1.
TRUSTED_PROXY_HOPS=0

# Set to 1 to force the Secure flag on session cookies (recommended in
# production). Behind a trusted proxy (TRUSTED_PROXY_HOPS >= 1) Secure is
# also applied automatically when X-Forwarded-Proto says https.
COOKIE_SECURE=0

# Where the SQLite database lives. Default: ./midround.db next to server.js.
# Containers should point this at a mounted volume.
#MIDROUND_DB_PATH=/data/midround.db

# Set to "production" on a real server. This disables demo-org seeding —
# locally an empty database gets 8 demo accounts with a well-known password,
# which must never appear on a public deployment. (SEED_DEMO=1 overrides,
# for throwaway staging environments only.)
#NODE_ENV=production
